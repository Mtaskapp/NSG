# =========================================
# SNAPBOT ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in values
# =========================================

# --- APP ---
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com
LOG_LEVEL=info

# --- WHATSAPP (Meta Cloud API) ---
# Primary multi-client configuration: edit clients.json. Each entry can have
# its own phoneNumberId, accessToken, verifyToken, and Google Sheet ID.
# The variables below are optional legacy fallback values used only when
# clients.json is absent.
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_ACCESS_TOKEN=your_permanent_access_token
WA_VERIFY_TOKEN=your_custom_verify_token_string
WA_WEBHOOK_PATH=/webhook/whatsapp
WA_GRAPH_VERSION=v20.0

# --- CLOUDFLARE R2 (S3-compatible media storage) ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=issue-images
R2_PUBLIC_BASE_URL=https://cdn.example.com

# --- TELEGRAM ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_PATH=/webhook/telegram
# Leave empty to use polling in dev
TELEGRAM_USE_WEBHOOK=true

# --- LINE ---
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_WEBHOOK_PATH=/webhook/line

# --- WEB WIDGET ---
WEB_WIDGET_ENABLED=true
WEB_WIDGET_CORS_ORIGINS=https://your-site.com,https://another-site.com

# --- GOOGLE SHEETS (case logging) ---
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_TAB=Cases
# Alternatively use a downloaded service-account JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GOOGLE_SERVICE_ACCOUNT_EMAIL=snapbot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# --- SECURITY ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
