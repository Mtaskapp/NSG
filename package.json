{
  "name": "snapbot",
  "version": "1.0.0",
  "description": "SnapBot - Multi-platform civic issue reporting bot (WhatsApp, Telegram, LINE, Web)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
    "lint": "eslint src/",
    "docker:build": "docker build -t snapbot .",
    "docker:run": "docker run -p 3000:3000 --env-file .env snapbot"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@line/bot-sdk": "^9.1.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "googleapis": "^128.0.0",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.64.0",
    "twilio": "^6.0.2",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "chatbot",
    "whatsapp",
    "telegram",
    "civic",
    "reporting"
  ],
  "license": "MIT"
}
